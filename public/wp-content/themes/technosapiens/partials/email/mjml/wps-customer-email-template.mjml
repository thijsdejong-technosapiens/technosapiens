<mjml>
    <mj-head>
        <mj-attributes>
            <mj-class name="body" background-color="#f6f5f5" width="600px"/>
            <mj-class name="header" background-color="#ffffff" padding="20px" border-bottom="1px solid #eeeeee"/>
            <mj-class name="logo" width="225px" align="center"/>
            <mj-class name="content" background-color="#ffffff" padding="20px" border-bottom="1px solid #eeeeee"/>
            <mj-class name="heading" color="#070733" font-size="20px" line-height="25px" font-weight="700"
                      align="center" padding="0 0 10px"/>
            <mj-class name="paragraph" color="#070733" font-size="14px" line-height="21px" font-weight="400"
                      align="center" padding="0 0 10px"/>
            <mj-class name="label" background-color="#f2f2f5" padding="12px 15px" border-bottom="1px solid #eeeeee"
                      width="100%"/>
            <mj-class name="label-text" color="#070733" font-size="13px" line-height="20px" font-weight="700"
                      align="left" padding="0"/>
            <mj-class name="value" background-color="#ffffff" padding="12px 15px" border-bottom="1px solid #eeeeee"
                      width="100%"/>
            <mj-class name="value-text" color="#070733" font-size="13px" line-height="20px" font-weight="400"
                      align="left" padding="0"/>
            <mj-class name="footer-main" background-color="#f2f2f5" padding="10px" border-bottom="1px solid #eeeeee"/>
            <mj-class name="footer-bar" background-color="#ffffff" padding="10px 0 0"/>
            <mj-class name="copyright" color="#070733" font-size="14px" line-height="20px" font-weight="400"
                      align="center" padding="0 0 10px"/>
            <mj-class name="social-links" font-size="15px" icon-size="35px" mode="horizontal"/>
            <mj-class name="social-links-items" padding="5px"/>
            <mj-all padding="0" font-family="Arial, sans-serif"/>
            <mj-text font-size="14px" line-height="21px" font-weight="400" color="#070733" padding="0"/>
        </mj-attributes>
    </mj-head>
    <mj-body mj-class="body">
        <mj-section>
            <mj-column>
                <mj-divider border-width="20px" border-color="#f6f5f5"/>
            </mj-column>
        </mj-section>
        <mj-section mj-class="header">
            <mj-column>
                <mj-image mj-class="logo"
                          src="data:image/svg+xml;base64,"/>
            </mj-column>
        </mj-section>
        <mj-section mj-class="content">
            <mj-column>
                <mj-text mj-class="heading">Techno Sapiens starter, we hebben je vraag ontvangen</mj-text>
                <mj-text mj-class="paragraph">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
                    tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
                    exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in
                    reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint
                    occaecat cupidatat non proident
                </mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column mj-class="label">
                <mj-text mj-class="label-text">Jouw naam</mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column mj-class="value">
                <mj-text mj-class="value-text">Rim Coonen</mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column mj-class="label">
                <mj-text mj-class="label-text">Jouw E-mailadres</mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column mj-class="value">
                <mj-text mj-class="value-text">rimcoonen@technosapiens.com</mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column mj-class="label">
                <mj-text mj-class="label-text">Jouw bericht</mj-text>
            </mj-column>
        </mj-section>
        <mj-section mj-class="table">
            <mj-column mj-class="value">
                <mj-text mj-class="value-text">Dit is een test van een developer</mj-text>
            </mj-column>
        </mj-section>
        <mj-section mj-class="footer-main">
            <mj-column>
                <mj-social mj-class="social-links">
                    <mj-social-element mj-class="social-links-items" href="https://www.google.nl/"
                                       src="data:image/png;base64,">
                    </mj-social-element>
                    <mj-social-element mj-class="social-links-items" href="https://www.google.nl/"
                                       src="data:image/png;base64,">
                    </mj-social-element>
                    <mj-social-element mj-class="social-links-items" href="https://www.google.nl/"
                                       src="data:image/png;base64,">
                    </mj-social-element>
                    <mj-social-element mj-class="social-links-items" href="https://www.google.nl/"
                                       src="data:image/png;base64,">
                    </mj-social-element>
                </mj-social>
            </mj-column>
        </mj-section>
        <mj-section mj-class="footer-bar">
            <mj-column>
                <mj-text mj-class="copyright">© 2023 - Techno Sapiens</mj-text>
            </mj-column>
        </mj-section>
        <mj-section>
            <mj-column>
                <mj-divider border-width="20px" border-color="#f6f5f5"/>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>

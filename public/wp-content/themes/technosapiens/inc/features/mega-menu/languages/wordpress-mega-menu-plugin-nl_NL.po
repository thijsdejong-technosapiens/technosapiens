msgid "Mega menus"
msgstr "Mega menus"

#: partials/mega-menu-opening.php:66
msgid "Close menu"
msgstr "Menu sluiten"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:60
msgid "Two columns with card"
msgstr "Twee kolommen met card"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:131
#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:477
msgid "Image only"
msgstr "Alleen afbeelding"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:145
msgid "Card image"
msgstr "Card afbeelding"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:333
msgid "Selected menu"
msgstr "Geselecteerd menu"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:423
msgid "Navigation menu"
msgstr "Navigatiemenu"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:427
msgid "Select a navigation menu to get the items from."
msgstr "Selecteer een navigatiemenu om de items op te halen."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:455
msgid "Content type"
msgstr "Content type"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:459
msgid "Choose what type of content to display in the third column."
msgstr "Kies welk type content je in de derde kolom wilt weergeven."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:476
msgid "No content"
msgstr "Geen content"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:478
msgid "Image with call to action"
msgstr "Afbeelding met call to action"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:489
msgid "Image"
msgstr "Afbeelding"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:493
msgid ""
"Select an image to display in the call to action in the third column. The "
"recommended size when using a call to action is <code>600px wide and 300px "
"high</code> and when using only an image is <code>600px wide and a "
"proportional height</code>."
msgstr ""
"Selecteer een afbeelding om weer te geven in de call to action in de derde "
"kolom. De aanbevolen grootte bij gebruik van een call to action is "
"<code>600px breed en 300px hoog</code> en bij gebruik van alleen een "
"afbeelding is dit <code>600px breed en een proportionele hoogte</code>."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:529
msgid "Call to action title"
msgstr "Call to action titel"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:533
msgid "Enter a title for the call to action in the third column."
msgstr "Voer een titel in voor de call to action in de derde kolom."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:558
msgid "Call to action description"
msgstr "Call to action omschrijving"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:562
msgid ""
"Enter an (optional) description text for the call to action in the third "
"column."
msgstr ""
"Voer een (optionele) omschrijving in voor de call to action in de derde "
"kolom."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:587
msgid "Call to action link"
msgstr "Call to action link"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:591
msgid ""
"Set the destination link for the call to action button in the third column."
msgstr ""
"Stel de bestemmingslink in voor de call to action knop in de derde kolom."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:612
msgid "Button style"
msgstr "Stijl van de knop"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:616
msgid ""
"Choose the visual style for the call to action button in the third column."
msgstr "Kies de visuele stijl voor de call to action knop in de derde kolom."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:645
msgid "Button color"
msgstr "Kleur van de knop"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:649
msgid ""
"Select the color scheme for the call to action button in the third column."
msgstr ""
"Selecteer het kleurenschema voor de call to action knop in de derde kolom."

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:676
msgid "Button size"
msgstr "Grootte van de knop"

#: presets/two-columns-with-card-preset/TwoColumnsWithCardPreset.php:680
msgid "Choose the size of the call to action button in the third column."
msgstr "Kies de grootte van de call to action knop in de derde kolom."

